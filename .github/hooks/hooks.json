{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "node .github/hooks/session-context.mjs",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/guard-sensitive-paths.mjs",
        "timeoutSec": 5
      }
    ]
  }
}
